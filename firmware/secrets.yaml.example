# Copy this file to secrets.yaml and set your own values.
# secrets.yaml is gitignored.

wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Password for over-the-air updates. Choose your own. The first flash over the
# factory firmware needs none; every later flash needs this one.
ota_password: "YOUR_OTA_PASSWORD"
